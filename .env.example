# GLIMMER & GRACE — Firebase Configuration
# Copy this file to .env and replace with your real Firebase Project credentials.
# Never commit .env or private credentials to GitHub.

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=glimmer-and-grace.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=glimmer-and-grace
VITE_FIREBASE_STORAGE_BUCKET=glimmer-and-grace.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
